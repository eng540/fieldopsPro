{
  "name": "fieldops-frontend",
  "version": "4.0.0-sprint0",
  "description": "FieldOps SaaS V4.0 -- Offline-First React Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3",
    "react-dom": "^18.3",
    "react-router-dom": "^6.23",
    "zustand": "^4.5",
    "dexie": "^4.0",
    "dexie-react-hooks": "^1.1",
    "tailwindcss": "^3.4",
    "@radix-ui/react-dialog": "^1.0",
    "@radix-ui/react-dropdown-menu": "^2.0",
    "@radix-ui/react-tabs": "^1.0",
    "class-variance-authority": "^0.7",
    "clsx": "^2.1",
    "tailwind-merge": "^2.3",
    "lucide-react": "^0.378",
    "uuid": "^9.0",
    "date-fns": "^3.6",
    "react-window": "^1.8",
    "react-virtualized-auto-sizer": "^1.0",
    "workbox-window": "^7.1"
  },
  "devDependencies": {
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "@types/react-window": "^1.8",
    "@vitejs/plugin-react": "^4.3",
    "@playwright/test": "^1.44",
    "autoprefixer": "^10.4",
    "eslint": "^8.57",
    "eslint-plugin-react-hooks": "^4.6",
    "eslint-plugin-react-refresh": "^0.4",
    "postcss": "^8.4",
    "prettier": "^3.2",
    "typescript": "^5.4",
    "vite": "^5.2",
    "vite-plugin-pwa": "^0.20",
    "vitest": "^1.6",
    "@testing-library/react": "^15.0",
    "@testing-library/jest-dom": "^6.4",
    "jsdom": "^24.1",
    "@types/uuid": "^9.0.8"
  }
}
