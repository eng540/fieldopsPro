# FieldOps V4.0 — Environment Variables
# Copy this file to .env and fill in REAL values
# NEVER commit .env to version control

# ─────────────────────────────────────────
# REQUIRED SECRETS (Generate strong values)
# ─────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_32_CHARS
SECRET_KEY=CHANGE_ME_STRONG_SECRET_KEY_MIN_32_CHARS_ALPHANUMERIC

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
POSTGRES_USER=fieldops
POSTGRES_DB=fieldops
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fieldops:CHANGE_ME@localhost:5432/fieldops

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────
# Ports
# ─────────────────────────────────────────
API_PORT=8000
WEB_PORT=3000

# ─────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_VERSION=4.0.0-sprint0
