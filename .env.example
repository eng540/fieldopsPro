# FieldOps V4.0 — Environment Variables

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fieldops:fieldops@localhost:5432/fieldops_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production-min-32-chars-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,https://app.fieldops.dev
UPLOAD_DIR=/tmp/fieldops_uploads

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_ENV=development
